  id                String          @id @default(cuid())
  doorId            String
  door              DoorLock        @relation(fields: [doorId], references: [id], onDelete: Restrict)
  employeeId        String?
  employee          Employee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  label             String
  fingerprint       String
  providerRef       String          @unique
  providerId        String?         @unique
  requestedBy       String
  requester         User            @relation("DoorCodeRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
