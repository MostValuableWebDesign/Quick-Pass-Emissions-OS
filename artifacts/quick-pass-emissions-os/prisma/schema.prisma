// Google source responses are encrypted, temporary caches (maximum 30 days).
// Business mappings, permissions and owner-entered actions are durable.
model GoogleBusinessConnection {
  id                 String                   @id
  status             String                   @default("DISCONNECTED")
  credentials        String?
  createdBy          String
  generation         Int                      @default(0)
  error              String?
  connectedAt        DateTime?
  discoveryAt        DateTime?
  discovery          String?
  discoveryExpiresAt DateTime?
  rateLimitedUntil   DateTime?
  cooldownUntil      DateTime?
  locations          GoogleBusinessLocation[]
}

model GoogleBusinessOAuth {
  stateHash   String   @id
  browserHash String
  actorId     String
  generation  Int
  verifier    String
  expiresAt   DateTime
}

model AnalyticsStation {
  id                String                   @id @default(cuid())
  name              String
  stationHash       String                   @unique
  timezoneConfirmed Boolean                  @default(false)
  createdBy         String
  grants            AnalyticsStationGrant[]
  locations         GoogleBusinessLocation[]
  actions           AnalyticsAction[]
  attribution       MarketingAttribution[]
}

