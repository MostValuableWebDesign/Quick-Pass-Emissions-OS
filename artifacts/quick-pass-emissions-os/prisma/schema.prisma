generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Created once by a migration, retained across releases and database backups.
model DataStore {
  id         String   @id @default("business")
  instanceId String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now())
}

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
  BOOKKEEPER
}

model MarketingCampaign {
  id            String                 @id @default(cuid())
  name          String
  channel       String
  stationHashes Json
  startDate     String
  endDate       String
  offer         String                 @default("")
  budgetCents   Int                    @default(0)
  status        String                 @default("DRAFT")
  version       Int                    @default(0)
  createdBy     String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  expenses      MarketingExpense[]
  promos        MarketingPromo[]
  observations  MarketingObservation[]
  actions       MarketingAction[]
  materials     MarketingMaterial[]
}

model MarketingExpense {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  stationHash String
  date        String
  amountCents Int
  description String
  reference   String            @unique
  createdBy   String
  createdAt   DateTime          @default(now())
  voidedAt    DateTime?
  voidReason  String?

  @@index([campaignId, date])
}

model MarketingPromo {
  approvalStatus  String                @default("LEGACY_REVIEW")
  eligibleService String                @default("EMISSIONS")
  eligibility     String                @default("")
  minimumCents    Int?
  stackingAllowed Boolean               @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  id              String                @id @default(cuid())
  campaignId      String
  campaign        MarketingCampaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  code            String                @unique
  kind            String
  value           Int
  startDate       String
  endDate         String
  stationHashes   Json
  usageLimit      Int
  active          Boolean               @default(true)
  version         Int                   @default(0)
  createdBy       String
  createdAt       DateTime              @default(now())
  redemptions     MarketingRedemption[]
}

model MarketingObservation {
  id             String             @id @default(cuid())
  recordId       String?            @unique
  record         StationRecord?     @relation(fields: [recordId], references: [id], onDelete: Restrict)
  serviceId      String?            @unique
  service        DealerService?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  stationHash    String
  date           String
  source         String?
  campaignId     String?
  campaign       MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  inspectionKind String             @default("UNKNOWN")
  evidence       String             @default("")
  version        Int                @default(0)
  createdBy      String
  updatedAt      DateTime           @updatedAt

  @@index([stationHash, date])
}

model MarketingRedemption {
  id            String         @id @default(cuid())
  promoId       String
  promo         MarketingPromo @relation(fields: [promoId], references: [id], onDelete: Restrict)
  serviceId     String         @unique
  service       DealerService  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  stationHash   String
  date          String
  baseCents     Int
  discountCents Int
  finalCents    Int
  terms         Json
  createdBy     String
  createdAt     DateTime       @default(now())
}

model MarketingAction {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  title       String
  rationale   String
  periodStart String
  periodEnd   String
  reviewDate  String
  status      String            @default("PLANNED")
  resultNotes String            @default("")
  baseline    Json
  version     Int               @default(0)
  createdBy   String
  createdAt   DateTime          @default(now())
}

model MarketingMaterial {
  id         String            @id @default(cuid())
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  title      String
  copy       String            @default("")
  objectPath String?
  filename   String?
  mimeType   String?
  byteSize   Int?
  status     String            @default("DRAFT")
  version    Int               @default(0)
  createdBy  String
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime          @default(now())
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum Frequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

model User {
  requestedDoorCodes     DoorAccessCode[]        @relation("DoorCodeRequester")
  registeredDoors        DoorLock[]              @relation("DoorRegistrar")
  ownerSummaryEmails     OwnerSummaryEmail[]
  ownerEmailSettings     OwnerEmailSetting[]     @relation("EmailSettingOwner")
  supportContactHistory  SupportContactHistory[]
  businessImports        BusinessImport[]
  automationDeliveries   AutomationDelivery[]
  maintenanceReports     MaintenanceTicket[]     @relation("TicketReporter")
  id                     String                  @id @default(cuid())
  name                   String
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  image                  String?
  phone                  String                  @default("")
  role                   Role                    @default(EMPLOYEE)
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  accounts               Account[]
  employee               Employee?
  auditLogs              AuditLog[]
  notifications          Notification[]
  reminderEvents         ReminderEvent[]
  performancePanelLayout PerformancePanelLayout?
}

model PerformancePanelLayout {
  userId    String   @id
  layout    Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Employee {
  doorCodes            DoorAccessCode[]
  responsibleBays      CarwashBay[]        @relation("BayResponsible")
  maintenancePlans     MaintenancePlan[]   @relation("PlanAssignee")
  maintenanceTickets   MaintenanceTicket[] @relation("TicketAssignee")
  id                   String              @id @default(cuid())
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id])
  phone                String              @default("")
  jobRole              String              @default("")
  streetAddress        String              @default("")
  addressLine2         String              @default("")
  city                 String              @default("")
  state                String              @default("")
  postalCode           String              @default("")
  startDate            String?
  duties               String              @default("")
  workAreas            String              @default("")
  managerNotes         String              @default("")
  certificationExpires String?
  demo                 Boolean             @default(false)
  shifts               EmployeeSchedule[]
  templates            TaskTemplate[]
  tasks                TaskInstance[]
  invites              Invite[]
  payArrangements      PayArrangement[]
  commissionPolicies   CommissionPolicy[]
  emissions            DailyEmission[]
  payrollInputs        PayrollInput[]
  payrollLines         PayrollLine[]
  addressSource        String              @default("MANUAL")
  addressProviderId    String              @default("")
}

model Invite {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model EmployeeSchedule {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       String
  startTime  String
  endTime    String
  duties     String

  @@unique([employeeId, date])
  @@index([date])
}

model BusinessSetting {
  id             String   @id @default("business")
  operatingDays  Int[]    @default([])
  operatingHours Json     @default("{}")
  configured     Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model Closure {
  date   String @id
  reason String
}

model TaskTemplate {
  generatedThrough String?
  version          Int            @default(0)
  workspaceKey     String?        @unique
  managerTask      Boolean        @default(false)
  area             String         @default("GENERAL")
  station          String         @default("")
  durationMinutes  Int            @default(30)
  checklist        Json           @default("[]")
  oversightId      String?
  sourceHref       String         @default("")
  id               String         @id @default(cuid())
  title            String
  description      String         @default("")
  frequency        Frequency
  startDate        String
  endDate          String?
  weekdays         Int[]          @default([])
  dueTime          String
  priority         Priority       @default(NORMAL)
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id])
  reviewRequired   Boolean        @default(false)
  escalationHours  Int            @default(0)
  active           Boolean        @default(true)
  demo             Boolean        @default(false)
  createdAt        DateTime       @default(now())
  instances        TaskInstance[]
}

model TaskInstance {
  managerTask     Boolean          @default(false)
  area            String           @default("GENERAL")
  station         String           @default("")
  durationMinutes Int              @default(30)
  checklist       Json             @default("[]")
  oversightId     String?
  sourceHref      String           @default("")
  evidence        String           @default("")
  dependencies    TaskDependency[] @relation("Dependent")
  dependents      TaskDependency[] @relation("Prerequisite")
  id              String           @id @default(cuid())
  templateId      String
  template        TaskTemplate     @relation(fields: [templateId], references: [id])
  occurrenceDate  String
  title           String
  description     String
  dueAt           DateTime
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  priority        Priority
  reviewRequired  Boolean
  escalationHours Int
  status          TaskStatus       @default(PENDING)
  completedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  version         Int              @default(0)
  events          TaskEvent[]
  notifications   Notification[]

  @@unique([templateId, occurrenceDate])
  @@index([employeeId, dueAt])
  @@index([status, dueAt])
  @@index([area, dueAt])
}

model TaskDependency {
  taskId         String
  task           TaskInstance @relation("Dependent", fields: [taskId], references: [id], onDelete: Restrict)
  prerequisiteId String
  prerequisite   TaskInstance @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Restrict)

  @@id([taskId, prerequisiteId])
}

model ManagerAvailability {
  userId         String   @id
  version        Int      @default(0)
  days           Json
  reservePercent Int
  updatedAt      DateTime @updatedAt
}

model ManagerCommitment {
  id          String    @id @default(cuid())
  userId      String
  title       String
  date        String
  startTime   String
  endTime     String
  cancelledAt DateTime?

  @@index([userId, date])
}

model ManagerSchedule {
  id                  String    @id @default(cuid())
  userId              String
  startDate           String
  status              String    @default("DRAFT")
  availabilityVersion Int?
  payload             Json
  createdAt           DateTime  @default(now())
  approvedAt          DateTime?

  @@index([userId, startDate])
}

model SupplyItem {
  id              String           @id @default(cuid())
  name            String           @unique
  unit            String
  balance         Int?
  reorderLevel    Int?
  preferredVendor String           @default("")
  version         Int              @default(0)
  countedAt       DateTime?
  purchases       SupplyPurchase[]
}

model SupplyPurchase {
  id           String     @id @default(cuid())
  itemId       String
  item         SupplyItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity     Int
  vendor       String
  reference    String     @unique
  status       String     @default("PREPARED")
  version      Int        @default(0)
  receivedAt   DateTime?
  reconciledAt DateTime?
  createdBy    String
  createdAt    DateTime   @default(now())
}

model ManagerFinancialEvidence {
  id           String    @id @default(cuid())
  kind         String
  sourceKey    String    @unique
  amountCents  Int
  date         String
  method       String
  reference    String    @unique
  notes        String
  createdBy    String
  createdAt    DateTime  @default(now())
  reconciledAt DateTime?
  reconciledBy String?
}

model ManagerBankPolicy {
  id               String @id @default("business")
  remoteLimitCents Int?
  version          Int    @default(0)
}

model TaskEvent {
  id        String       @id @default(cuid())
  taskId    String
  task      TaskInstance @relation(fields: [taskId], references: [id])
  actorId   String
  actorName String
  action    String
  note      String       @default("")
  createdAt DateTime     @default(now())

  @@index([taskId, createdAt])
}

model Notification {
  maintenanceId String?
  maintenance   MaintenanceTicket? @relation(fields: [maintenanceId], references: [id])
  id            String             @id @default(cuid())
  key           String             @unique
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  taskId        String?
  task          TaskInstance?      @relation(fields: [taskId], references: [id])
  title         String
  readAt        DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime           @default(now())

  @@index([maintenanceId])
  @@index([userId, resolvedAt])
}

model ReminderEvent {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  title        String
  description  String    @default("")
  location     String    @default("")
  startsAt     DateTime
  alertAt      DateTime
  alertMinutes Int       @default(15)
  readAt       DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, alertAt, readAt])
  @@index([userId, startsAt, completedAt, cancelledAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entityId  String
  details   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model JobRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("RUNNING")
  generated   Int       @default(0)
  message     String?
}

model BusinessImport {
  id                String   @id
  sourceFingerprint String
  sourceName        String
  actorId           String
  actor             User     @relation(fields: [actorId], references: [id])
  storeId           String   @db.Uuid
  createdAt         DateTime @default(now())
  items             Json
  counts            Json

  @@index([createdAt])
}

enum PayKind {
  FIXED
  HOURLY
  DAILY
  WEEKLY
}

enum PayrollStatus {
  OPEN
  APPROVED
  CANCELLED
}

enum DraftStatus {
  DRAFT
  RETURNED
  APPROVED
}

enum MovementKind {
  OPENING
  USAGE
  VOID
  RECONCILE
  RECEIPT
}

enum PurchaseStatus {
  REQUESTED
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}

model PayArrangement {
  id                     String   @id @default(cuid())
  employeeId             String
  employee               Employee @relation(fields: [employeeId], references: [id])
  effectiveDate          String
  kind                   PayKind
  amountCents            Int
  scheduledDaysPerWeek   Int?
  scheduledMinutesPerDay Int?
  reason                 String
  createdBy              String
  createdAt              DateTime @default(now())

  @@unique([employeeId, effectiveDate])
}

model CommissionPolicy {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id])
  effectiveDate       String
  eligible            Boolean
  threshold           Int
  rateCents           Int
  volumeThreshold     Int?
  volumeIncreaseCents Int?
  attribution         String
  reason              String
  createdBy           String
  createdAt           DateTime @default(now())

  @@unique([employeeId, effectiveDate])
}

model DailyEmission {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       String
  count      Int
  sourceRef  String    @unique
  reason     String
  version    Int       @default(0)
  createdBy  String
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

model PayrollPeriod {
  id              String         @id @default(cuid())
  startDate       String
  endDate         String
  label           String
  status          PayrollStatus  @default(OPEN)
  cancelledReason String?
  createdBy       String
  createdAt       DateTime       @default(now())
  inputs          PayrollInput[]
  drafts          PayrollDraft[]

  @@index([startDate, endDate])
}

model PayrollInput {
  id                String        @id @default(cuid())
  periodId          String
  period            PayrollPeriod @relation(fields: [periodId], references: [id])
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id])
  minutes           Int
  paidDays          Int?
  emissionsComplete Boolean
  reason            String
  version           Int           @default(0)
  createdBy         String
  approvedBy        String?
  approvedAt        DateTime?

  @@unique([periodId, employeeId])
}

model PayrollDraft {
  id           String        @id @default(cuid())
  periodId     String
  period       PayrollPeriod @relation(fields: [periodId], references: [id])
  revision     Int
  status       DraftStatus   @default(DRAFT)
  preparedBy   String
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewReason String?
  totalCents   Int
  createdAt    DateTime      @default(now())
  lines        PayrollLine[]

  @@unique([periodId, revision])
}

model PayrollLine {
  id              String       @id @default(cuid())
  draftId         String
  draft           PayrollDraft @relation(fields: [draftId], references: [id])
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id])
  employeeName    String
  baseCents       Int
  commissionCents Int
  totalCents      Int
  snapshot        Json

  @@unique([draftId, employeeId])
}

model CertificateSetting {
  id           String   @id @default("certificates")
  minimumOrder Int
  reorderPoint Int?
  leadDays     Int?
  windowDays   Int?
  updatedAt    DateTime @updatedAt
}

model CertificateStock {
  id             String   @id @default("certificates")
  balance        Int
  version        Int      @default(0)
  openingDate    String
  reconciledDate String
  updatedAt      DateTime @updatedAt
}

model CertificateMovement {
  id           String               @id @default(cuid())
  kind         MovementKind
  delta        Int
  balanceAfter Int
  date         String
  reference    String               @unique
  reason       String
  createdBy    String
  purchaseId   String?
  purchase     CertificatePurchase? @relation(fields: [purchaseId], references: [id])
  createdAt    DateTime             @default(now())

  @@index([date, kind])
}

model CertificatePurchase {
  id               String                @id @default(cuid())
  quantity         Int
  minimumOrder     Int
  status           PurchaseStatus        @default(REQUESTED)
  requestedBy      String
  approvedBy       String?
  approvedAt       DateTime?
  confirmation     String?
  paymentReference String?
  received         Int                   @default(0)
  reason           String
  reviewReason     String?
  createdAt        DateTime              @default(now())
  movements        CertificateMovement[]
}

enum BayType {
  SELF_SERVICE
  DETAILING
}

enum BayStatus {
  UNKNOWN
  OPERATIONAL
  MAINTENANCE_REQUIRED
  OUT_OF_SERVICE
  UNDER_REPAIR
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  AWAITING_REVIEW
  COMPLETED
  CANCELLED
}

enum EquipmentCategory {
  ANALYZER
  KIOSK
  PUMP
  HOSE
  BRUSH
  NOZZLE
  DISPENSER
  DRAIN_PIT
  PROPERTY
  OTHER
}

enum ChemicalUnit {
  ML
  GRAM
  ITEM
}

enum ChemicalMovementKind {
  OPENING
  RECONCILE
  RECEIPT
  USAGE
  DISPOSAL
}

enum RentalStatus {
  ACTIVE
  ENDED
  CANCELLED
}

model CarwashBay {
  supportAssociations SupportAssociation[]
  id                  String               @id @default(cuid())
  slot                Int                  @unique
  identifier          String               @unique
  type                BayType
  status              BayStatus            @default(UNKNOWN)
  notes               String               @default("")
  responsibleId       String?
  responsible         Employee?            @relation("BayResponsible", fields: [responsibleId], references: [id])
  version             Int                  @default(0)
  equipment           Equipment[]
  tickets             MaintenanceTicket[]
  plans               MaintenancePlan[]
  downtime            DowntimeEvent[]
  rentals             BayRentalAgreement[]
}

model Vendor {
  categories              String[]                @default([])
  extension               String                  @default("")
  alternateContact        String                  @default("")
  alternatePhone          String                  @default("")
  alternateExtension      String                  @default("")
  alternateEmail          String                  @default("")
  website                 String                  @default("")
  supportUrl              String                  @default("")
  hours                   String                  @default("")
  emergencyDetails        String                  @default("")
  emergencyPhone          String                  @default("")
  operationalInstructions String                  @default("")
  supportedServices       String                  @default("")
  sourceReference         String                  @default("")
  lastConfirmedDate       String?
  accountReference        String                  @default("")
  preferences             SupportPreference[]
  supportAssociations     SupportAssociation[]
  contactHistory          SupportContactHistory[]
  id                      String                  @id @default(cuid())
  name                    String
  contact                 String
  phone                   String
  email                   String
  services                String
  reference               String
  verifiedDate            String?
  notes                   String                  @default("")
  active                  Boolean                 @default(true)
  version                 Int                     @default(0)
  equipment               Equipment[]
  tickets                 MaintenanceTicket[]
  chemicals               ChemicalItem[]
  addressSource           String                  @default("MANUAL")
  addressProviderId       String                  @default("")
  streetAddress           String                  @default("")
  addressLine2            String                  @default("")
  city                    String                  @default("")
  state                   String                  @default("")
  postalCode              String                  @default("")
}

model SupportPreference {
  category String  @id
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  version  Int     @default(0)
}

model SupportAssociation {
  id          String      @id @default(cuid())
  vendorId    String
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  equipmentId String?
  equipment   Equipment?  @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  bayId       String?
  bay         CarwashBay? @relation(fields: [bayId], references: [id], onDelete: Restrict)

  @@unique([vendorId, equipmentId])
  @@unique([vendorId, bayId])
}

model SupportContactHistory {
  id           String             @id @default(cuid())
  vendorId     String
  vendor       Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  actorId      String
  actor        User               @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorName    String
  contactedAt  DateTime
  method       String
  equipmentId  String?
  equipment    Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  ticketId     String?
  ticket       MaintenanceTicket? @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  outcome      String             @default("")
  reference    String             @default("")
  followUpDate String?
  createdAt    DateTime           @default(now())

  @@index([vendorId, createdAt])
}

model Equipment {
  supportAssociations SupportAssociation[]
  contactHistory      SupportContactHistory[]
  id                  String                  @id @default(cuid())
  code                String                  @unique
  name                String
