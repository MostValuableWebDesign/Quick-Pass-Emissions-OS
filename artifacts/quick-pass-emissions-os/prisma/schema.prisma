  stationId String
  userId    String
  station   AnalyticsStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([stationId, userId])
}

model GoogleBusinessLocation {
  id           String                   @id @default(cuid())
  connectionId String
  connection   GoogleBusinessConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  accountName  String
  locationName String                   @unique
  stationId    String                   @unique
  station      AnalyticsStation         @relation(fields: [stationId], references: [id], onDelete: Restrict)
  enabled      Boolean                  @default(true)
  createdBy    String
  tasks        GoogleBusinessSync[]
  requests     GoogleBusinessRequest[]
  cache        GoogleBusinessCache[]
}

model GoogleBusinessRequest {
  id          String                 @id @default(cuid())
  locationId  String
  location    GoogleBusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy   String
  start       String
  end         String
  status      String                 @default("QUEUED")
  createdAt   DateTime               @default(now())
  completedAt DateTime?
  tasks       GoogleBusinessSync[]

  @@index([locationId, createdAt])
}

model GoogleBusinessSync {
  id             String                 @id @default(cuid())
  locationId     String
  location       GoogleBusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  requestId      String?
  request        GoogleBusinessRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  publishedCycle String?
  publishedPage  Int?
  kind           String
  period         String
  status         String                 @default("QUEUED")
  cycle          String
  page           Int                    @default(0)
  cursor         String?
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime               @default(now())
  leaseToken     String?
  leaseUntil     DateTime?
  lastSuccessAt  DateTime?
  error          String?
  updatedAt      DateTime               @updatedAt

  @@unique([locationId, kind, period])
  @@index([status, nextAttemptAt])
}

model GoogleBusinessCache {
  id         String                 @id @default(cuid())
  locationId String
  location   GoogleBusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  kind       String
  period     String
  cycle      String
  page       Int
  source     String                 @default("GOOGLE_BUSINESS_PROFILE_API")
  payload    String
  fetchedAt  DateTime               @default(now())
  expiresAt  DateTime

  @@unique([locationId, kind, period, cycle, page])
  @@index([expiresAt])
}

model AnalyticsAction {
  id         String           @id @default(cuid())
  stationId  String
  station    AnalyticsStation @relation(fields: [stationId], references: [id], onDelete: Restrict)
  category   String
  action     String
  date       String
  reviewDate String
  target     String
  outcome    String?
  createdBy  String
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?

  @@index([stationId, date])
}

model MarketingAttribution {
  id        String           @id @default(cuid())
  stationId String
  station   AnalyticsStation @relation(fields: [stationId], references: [id], onDelete: Restrict)
  date      String
  channel   String
  customers Int
  costCents Int?
  reference String           @unique
  evidence  String
  createdBy String
  createdAt DateTime         @default(now())

  @@index([stationId, date])
}
