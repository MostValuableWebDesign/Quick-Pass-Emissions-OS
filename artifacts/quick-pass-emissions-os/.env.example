# PostgreSQL database dedicated to this application
DATABASE_URL="postgresql://quickpass:CHANGE_ME@localhost:5432/quickpass?schema=public"
# Pin after first migration using db:check or the owner Settings storage ID.
# Separate preview/production databases have their own IDs; never share a pin blindly.
EXPECTED_DATABASE_ID=""
# Optional private persistent backup directory. Never use ephemeral deployment storage.
# If configured, pending release migrations require a successful full backup first.
DATA_BACKUP_DIR=""
# Optional directory containing matching pg_dump/pg_restore; otherwise uses PATH.
PG_TOOLS_BIN=""
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
# CLI bootstrap only; never use a shared/default password
BOOTSTRAP_EMAIL=""
BOOTSTRAP_NAME=""
BOOTSTRAP_PASSWORD=""
# Bearer token for independently scheduled POST /api/jobs
CRON_SECRET=""
# Explicit local-only demo seed gate; never enable on production
ALLOW_DEMO_SEED="false"
# Local demo only; never seed a production database
DEMO_PASSWORD=""

# Optional US address suggestions. Server-only; never prefix with NEXT_PUBLIC_.
# No key / provider outage: manual address entry and saving remain available.
GEOAPIFY_API_KEY=""

# Daily owner email (server-only). Verify the sender domain with Resend first.
RESEND_API_KEY=""
OWNER_SUMMARY_FROM_EMAIL=""
# Public HTTPS origin only, e.g. https://quickpass.example.com (no path/query).
OWNER_SUMMARY_APP_URL=""

# Door access: connect Schlage Home in a Seam workspace first. Server-only.
SEAM_API_KEY=""
SEAM_CONNECTED_ACCOUNT_ID=""
# Independent stable secret: openssl rand -hex 32. Keep across releases/backups.
# Fingerprints only; actual PINs are never stored in Quick Pass.
DOOR_CODE_HMAC_KEY=""
