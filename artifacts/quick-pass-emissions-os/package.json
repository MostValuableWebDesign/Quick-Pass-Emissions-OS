{
  "name": "@workspace/quick-pass-emissions-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "dev": "tsx scripts/database.ts migrate && next dev --hostname 0.0.0.0 --port ${PORT:-3000}",
    "build": "prisma generate && next build",
    "start": "tsx scripts/database.ts migrate && next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:e2e": "node scripts/test-isolated.mjs --browser",
    "test:e2e:owned": "tsx scripts/browser-regression.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:check": "tsx scripts/database.ts check",
    "db:backup": "tsx scripts/database.ts backup",
    "db:restore": "tsx scripts/database.ts restore",
    "db:dev": "prisma migrate dev",
    "bootstrap": "tsx scripts/database.ts check && tsx scripts/bootstrap.ts",
    "seed:demo": "tsx scripts/seed.ts",
    "jobs": "tsx scripts/database.ts check && tsx scripts/jobs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "recover-account": "tsx scripts/database.ts check && tsx scripts/recover-account.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "1.4.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1"
  }
}
